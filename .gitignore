# Terraform working dirs and state — state can contain secrets, never commit it
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files often hold environment-specific or secret values.
# Commit only *.tfvars.example files.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Commit .terraform.lock.hcl in root configs (terraform/envs/*). It pins exact provider versions + checksums.
# Don't commit it in reusable modules. Modules don't choose versions; the root config that calls them does.
terraform/modules/**/.terraform.lock.hcl

# Local secrets
.env
.env.*
!.env.example

# LocalStack runtime data
.localstack/
volume/

# Go
controlplane/bin/
controlplane/controlplane
*.test
*.out
coverage.*

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
